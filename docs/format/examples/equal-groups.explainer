{
  "format": "chalkscript-explainer",
  "version": "1.0",
  "requires": ["components.arithmetic"],
  "id": "multiply-equal-groups",
  "title": "Multiplying as equal groups",
  "about": { "licence": "CC-BY-4.0" },
  "sourceLocale": "en-US",
  "params": {
    "a": { "type": "int", "min": 2, "max": 5 },
    "b": { "type": "int", "min": 2, "max": 6 }
  },
  "let": {
    "p": "a * b",
    "rows": "div(b + 1, 2)",
    "ringTime": 0.3,
    "dotGap": 0.12,
    "cx": 500,
    "perRow": "a",
    "gRows": 1,
    "gapX": 180,
    "gapY": 0,
    "gy": 170,
    "eqY": 70,
    "totalY": 470
  },
  "samples": [
    { "a": 2, "b": 2 },
    { "a": 2, "b": 6 },
    { "a": 3, "b": 4 },
    { "a": 4, "b": 3 },
    { "a": 5, "b": 2 },
    { "a": 5, "b": 5 },
    { "a": 5, "b": 6 }
  ],
  "kind": { "same": ["a == b"], "differ": ["a", "b", "p"] },
  "areas": [{ "layout": "stage", "ratio": [0.9, 2.2] }, { "layout": "tall", "ratio": [0.6, 0.9] }],
  "layouts": {
    "stage": { "size": [1000, 540] },
    "tall": {
      "let": {
        "blockH": "gRows * ringH + (gRows - 1) * 40",
        "cx": 240,
        "eqY": "round((640 - blockH - 205) / 2) + 25",
        "gRows": "div(a + perRow - 1, perRow)",
        "gapX": 150,
        "gapY": "ringH + 40",
        "gy": "eqY + 70",
        "perRow": "a == 4 ? 2 : min(a, 3)",
        "ringH": "52 + (rows - 1) * 34",
        "totalY": "gy + blockH + 90"
      },
      "size": [480, 640],
      "suits": "areaW < areaH * 0.9"
    }
  },
  "elements": {
    "equation": {
      "kind": "text",
      "style": "equation",
      "at": ["cx", "eqY"],
      "text": "equation",
      "runs": { "ans": { "ink": "result", "text": "unknown" } }
    },
    "ring": {
      "kind": "outline",
      "style": "ring",
      "repeat": "a",
      "ink": "multiply",
      "rect": [
        "cx - ((div(i, perRow) == gRows - 1 ? a - div(i, perRow) * perRow : perRow) - 1) * gapX / 2 - 43 + mod(i, perRow) * gapX",
        "gy + div(i, perRow) * gapY",
        86,
        "32 + (rows - 1) * 34 + 20"
      ],
      "start": { "progress": 0 }
    },
    "dot": {
      "kind": "circle",
      "repeat": "a * b",
      "rect": [
        "cx - ((div(div(i, b), perRow) == gRows - 1 ? a - div(div(i, b), perRow) * perRow : perRow) - 1) * gapX / 2 - 43 + mod(div(i, b), perRow) * gapX + 16 + mod(mod(i, b), 2) * 34",
        "gy + div(div(i, b), perRow) * gapY + 16 + div(mod(i, b), 2) * 34",
        20,
        20
      ],
      "start": { "opacity": 0 }
    },
    "hint": {
      "kind": "outline",
      "style": "hint",
      "around": "slice(dot, 0, b)",
      "start": { "progress": 0 }
    },
    "total": { "kind": "text", "style": "total", "at": ["cx", "totalY"] }
  },
  "parts": { "groups": "ring + dot", "count": "ring + dot + total" },
  "shots": { "whole": { "frame": ["count"] } },
  "opening": "whole",
  "intro": { "watch": "intro", "guided": "do.intro" },
  "sequence": ["groups", "same", "skip"],
  "steps": {
    "groups": {
      "shot": "whole",
      "say": "make",
      "hold": 0.4,
      "actions": {
        "build": {
          "do": "each",
          "target": "ring",
          "gap": "ringTime + b * dotGap",
          "then": {
            "ring": { "do": "draw", "dur": "ringTime" },
            "dots": {
              "do": "appear",
              "target": "slice(dot, i * b, b)",
              "at": "ringTime",
              "dur": 0.2,
              "each": "dotGap"
            }
          }
        }
      }
    },
    "same": {
      "shot": "whole",
      "say": "same",
      "hold": 0.5,
      "actions": {
        "mark": {
          "do": "tint",
          "target": "equation.b",
          "ink": "multiply",
          "dur": 0.35,
          "mark": true
        },
        "loop": { "do": "draw", "target": "hint", "dur": 0.9, "mark": true }
      }
    },
    "skip": {
      "shot": "whole",
      "say": "skip",
      "counts": true,
      "actions": {
        "count": {
          "do": "each",
          "target": "ring",
          "at": 0,
          "gap": 0.9,
          "wait": "voice",
          "let": { "n": "(i + 1) * b" },
          "then": {
            "look": { "do": "look", "target": "slice(dot, i * b, b)", "value": "counted" },
            "tag": { "do": "tag", "text": "tick", "dur": 0.8 },
            "say": { "do": "say", "line": "tick", "count": true },
            "total": { "do": "set", "target": "total", "text": "tick" }
          }
        },
        "pulse": { "do": "pulse", "target": "total", "at": "end(count) + 0.25", "dur": 0.5 },
        "answer": {
          "do": "appear",
          "target": "equation.ans",
          "text": "answerTotal",
          "at": "end(pulse)",
          "dur": 0.4,
          "wait": "voice"
        },
        "said": { "do": "say", "line": "answer", "at": "end(answer)", "wait": "voice" }
      },
      "act": {
        "input": "tap",
        "say": "do.skip",
        "targets": "ring",
        "pad": 12,
        "then": "count",
        "interrupts": true,
        "done": ["pulse", "answer", "said"],
        "misses": { "stroke": "do.touchGroup", "nothing": "do.touchGroup" }
      }
    }
  },
  "try": { "question": "question", "say": "do.tryIntro", "note": "do.tryNote" },
  "wording": {
    "en-US": {
      "shared": {
        "equation": { "text": "{a} × {b} = {ans}", "visual": true },
        "unknown": { "text": "?", "visual": true },
        "question": { "text": "{a} × {b} =", "visual": true },
        "tick": "{n}",
        "answerTotal": { "text": "{p}", "visual": true },
        "groups": { "forms": { "one": "{n} group", "other": "{n} groups" } }
      },
      "everyday": {
        "intro": "{a} times {b}. Let's see how!",
        "make": "Make {groups:a}, with {b} in each.",
        "same": "Every group has {b}. The groups are the same size.",
        "skip": "Count on {b} for each group.",
        "answer": { "text": "{a} times {b} is {p}!", "emphasis": "p" },
        "do.intro": "Now let's do one together: {a} times {b}.",
        "do.skip": "Touch each group to count on {b}.",
        "do.touchGroup": "Touch a group to count it.",
        "do.tryIntro": "Now you try one: {a} times {b}.",
        "do.tryNote": { "text": "Your turn. Draw the groups and count.", "visual": true }
      },
      "formal": {
        "intro": "{a} times {b}: {groups:a} of {b}.",
        "make": "{a} equal groups of {b}.",
        "same": "Each group has {b}, so the groups are equal.",
        "skip": "Skip-count by {b}, once for each group.",
        "answer": { "text": "{a} times {b} is {p}.", "emphasis": "p" }
      }
    }
  }
}
